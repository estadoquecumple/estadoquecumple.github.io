# Copiar como .env.lab y no confirmar en Git.

COMPOSE_PROJECT_NAME=estadoquecumple-territorial-v4
POSTGRES_PORT=55432
API_PORT=8001
LAB_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
PUBLIC_LAB_API_BASE_URL=http://localhost:8001

POSTGRES_DB=estadoquecumple
POSTGRES_ADMIN_USER=lab_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
POSTGRES_APP_USER=lab_app
POSTGRES_APP_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://lab_app:CHANGE_ME@db:5432/estadoquecumple

LAB_VAULT_PATH=/vault
LAB_MAX_UPLOAD_BYTES=10485760
LAB_JOB_TIMEOUT_SECONDS=300
LAB_JOB_MAX_ATTEMPTS=3

LLM_PROVIDER=none
EMBEDDING_PROVIDER=none
LOCAL_LLM_RUNTIME=
LOCAL_LLM_MODEL=
LOCAL_EMBEDDING_MODEL=
