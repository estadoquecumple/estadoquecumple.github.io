---
import RootsWorkspace from './RootsWorkspace.astro';
import SaviaWorkspace from './SaviaWorkspace.astro';
import SeedsWorkspace from './SeedsWorkspace.astro';
import ScenarioOutputs from './ScenarioOutputs.astro';
import TerritoryMap from './TerritoryMap.astro';
import Phase3AWorkspace from './Phase3AWorkspace.astro';
---
<div class="migration-notice" data-migration-notice hidden role="status">El Laboratorio fue actualizado. Los escenarios incompatibles de la versión anterior no se reutilizaron.</div>
<nav class="mode-navigation" aria-label="Instrumentos del Laboratorio" data-mode-navigation>
  <button type="button" data-mode="raices" aria-pressed="true"><strong>RAÍCES</strong><span>Ver</span></button>
  <button type="button" data-mode="savia" aria-pressed="false"><strong>SAVIA</strong><span>Evaluar</span></button>
  <button type="button" data-mode="semillas" aria-pressed="false"><strong>SEMILLAS</strong><span>Diseñar</span></button>
</nav>
<nav class="mobile-tabs" aria-label="Paneles del laboratorio">
  <button type="button" data-mobile-panel="controls" data-mobile-tab="controls" aria-pressed="false">Controles</button>
  <button type="button" data-mobile-panel="map" data-mobile-tab="map" aria-pressed="true">Mapa</button>
  <button type="button" data-mobile-panel="results" data-mobile-tab="results" aria-pressed="false">Resultados</button>
  <button type="button" data-mobile-panel="method" data-mobile-tab="method" aria-pressed="false">Método</button>
</nav>
<div class="lab-shell-v2">
  <aside class="lab-context" data-panel="controls" aria-label="Panel contextual">
    <RootsWorkspace />
    <SaviaWorkspace />
    <SeedsWorkspace />
  </aside>
  <main class="lab-map" data-panel="map"><TerritoryMap /></main>
  <aside class="lab-analysis" data-panel="results"><ScenarioOutputs /></aside>
</div>
<section class="selected-table" aria-labelledby="selected-table-title">
  <div class="table-toolbar">
    <div><p class="panel-number">ALTERNATIVA TEXTUAL</p><h2 id="selected-table-title">Tabla territorial y selección</h2></div>
    <label>Filtrar <input type="search" data-table-filter placeholder="Nombre o DIVIPOLA" /></label>
  </div>
  <div class="table-scroll"><table>
    <thead><tr><th scope="col">Seleccionar</th><th scope="col">Código</th><th scope="col">Nombre</th><th scope="col">Nivel</th><th scope="col">Tipo</th><th scope="col">Fuente</th></tr></thead>
    <tbody data-territory-table><tr><td colspan="6">Cargando tabla oficial…</td></tr></tbody>
  </table></div>
</section>
<section class="lab-lower" data-panel="method">
  <label>Profundidad de trabajo
    <select data-experience-mode>
      <option value="guided">Modo guiado</option>
      <option value="expert">Modo experto</option>
    </select>
  </label>
  <div data-guided-only class="guided-route">
    <strong>Recorrido guiado</strong>
    <ol><li>Seleccione RAÍCES, SAVIA o SEMILLAS.</li><li>Elija un territorio.</li><li>Revise el resultado y sus advertencias antes de exportar.</li></ol>
  </div>
  <p data-expert-only hidden><strong>Vista experta:</strong> se exponen metodología, procedencia, restricciones analíticas y metadatos completos del catálogo.</p>
  <details open><summary>Escenario e historial</summary><p data-scenario-summary>Estado actual bloqueado; no contiene operaciones editables.</p></details>
  <details data-expert-only hidden><summary>Metodología</summary><p>RAÍCES consulta datos observados; SAVIA calcula perfiles condicionados por pesos; SEMILLAS registra hipótesis y operaciones sin alterar cartografía oficial. Las divisiones geométricas no estiman población ni finanzas sin datos granulares.</p></details>
  <details data-v4-catalog data-expert-only hidden><summary>Catálogo, vigencia y evidencia V4</summary>
    <p data-catalog-summary>Cargando catálogo validado…</p>
    <div class="table-scroll"><table>
      <thead><tr><th>Fuente</th><th>Snapshot</th><th>Hash</th><th>Fecha</th><th>Cobertura</th><th>Transformación</th><th>Limitaciones</th><th>Calidad</th><th>Evidencia</th></tr></thead>
      <tbody data-source-catalog><tr><td colspan="9">Pendiente de carga.</td></tr></tbody>
    </table></div>
    <p data-analytics-status>DuckDB-Wasm permanece diferido; se inicializa sólo al abrir este catálogo.</p>
    <p>H3 es una malla analítica y no constituye división administrativa o legal.</p>
  </details>
  <details><summary>Descargas e intercambio</summary>
    <div class="download-actions">
      <button type="button" data-export-json disabled>Exportar JSON</button>
      <button type="button" data-export-geojson disabled>Exportar GeoJSON</button>
      <button type="button" data-export-csv disabled>Exportar CSV</button>
      <button type="button" data-export-method disabled>Ficha metodológica</button>
      <button type="button" data-share-link disabled>Generar enlace compartible</button>
      <button type="button" data-print>Imprimir</button>
      <label class="button-like">Importar JSON<input type="file" accept="application/json,.json" data-import-json /></label>
    </div>
    <p>Los escenarios grandes se descargan como archivo. No se almacenan datos personales.</p>
  </details>
  <details><summary>Comparación</summary>
    <div class="comparison-toolbar"><button type="button" data-compare-current disabled>Actual vs escenario</button><label>Escenario A <select data-compare-a></select></label><label>Escenario B <select data-compare-b></select></label><button type="button" data-compare-scenarios>Comparar</button></div>
    <div data-comparison-output><p>Cree escenarios para comparar estructura, competencias, gobierno, financiación, riesgos y cobertura.</p></div>
  </details>
</section>
<Phase3AWorkspace />
<div class="operation-announcer" data-operation-status role="status" aria-live="polite"></div>
<script>
  import {
    ScenarioTimeline,
    addUnit,
    assignCompetence,
    changeFinance,
    changeGovernment,
    changePlanning,
    classifyLegalImpact,
    createLevel,
    createScenario,
    duplicateScenario,
    exportScenario,
    importScenario,
    mergeUnits,
    migrateLocalState,
    splitByGeometry,
    splitByMembership,
    suppressUnit,
    type TerritorialScenario,
  } from '../../data/territorial/scenario-v2';
  import { ScenarioStore } from '../../data/territorial/scenario-store';
  import { territorialExamples } from '../../data/territorial/examples-v3';
  import { connectedSelection, normalizeSearch } from '../../data/territorial/selection-v3';
  import { subdivisionCaveat, subdivisionModels } from '../../data/territorial/subdivisions';
  import { scenarioToMapCollections } from '../../data/territorial/scenario-map';
  import { scenarioCsv } from '../../data/territorial/security';
  import { metricsForSelection } from '../../data/territorial/official-metrics';
  import { TerritorialAnalytics } from '../../data/territorial/analytics-v4';
  import { compileScenario, createCapsule } from '../../data/territorial/scenario-v4';

  type Selection = { id: string; code: string; name: string; level: 'department' | 'municipality'; unitType?: string; geometry?: unknown };
  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const $$ = <T extends Element>(selector: string) => [...document.querySelectorAll<T>(selector)];
  const appendText = (parent: Element, tag: string, text: string) => {
    const node = document.createElement(tag);
    node.textContent = text;
    parent.append(node);
    return node;
  };
  const renderConsequenceItems = (host: Element, items: TerritorialScenario['consequences'], empty: string) => {
    host.textContent = '';
    if (!items.length) return void appendText(host, 'p', empty);
    for (const item of items) {
      const article = document.createElement('article');
      article.dataset.kind = item.kind;
      appendText(article, 'strong', `${item.dimension} · ${item.kind}`);
      appendText(article, 'p', `${item.before} → ${item.decision} → ${item.after}`);
      appendText(article, 'p', `${item.explanation}${item.source ? ` Fuente: ${item.source}.` : ''}`);
      host.append(article);
    }
  };
  const store = new ScenarioStore();
  const scenarios = new Map<string, TerritorialScenario>();
  const selected = new Map<string, Selection>();
  let timeline: ScenarioTimeline | undefined;
  let departments: Array<any> = [];
  let municipalities: Array<any> = [];
  type LabMode = 'raices' | 'savia' | 'semillas';
  type MobilePanel = 'controls' | 'map' | 'results' | 'method';
  let mode: LabMode = 'raices';
  let experimentalGeometry: GeoJSON.Polygon | null = null;
  let municipalityIndex: Array<{code:string;departmentCode:string;name:string}> = [];
  let spatialCandidates: Selection[] = [];
  let spatialRelations = new Map<string,'intersection'|'containment'|'contact'>();
  let governmentMetrics: Array<{code:string;entityCount:number}> = [];
  let sgrMetrics: Array<{territoryLabel:string;projectCount:number}> = [];
  let secopMetrics: Array<{kind:string;recordCount:number|null}> = [];
  let foundation: any = null;
  let catalogLoaded = false;
  const polygonRings=(geometry:any):number[][][]=>geometry.type==='Polygon'?geometry.coordinates:geometry.coordinates.flat();
  const inside=(point:number[],ring:number[][])=>{let result=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++){const [xi,yi]=ring[i],[xj,yj]=ring[j];if(((yi>point[1])!==(yj>point[1]))&&(point[0]<(xj-xi)*(point[1]-yi)/(yj-yi)+xi))result=!result;}return result;};
  const orientation=(a:number[],b:number[],c:number[])=>Math.sign((b[0]-a[0])*(c[1]-a[1])-(b[1]-a[1])*(c[0]-a[0]));
  const crosses=(a:number[],b:number[],c:number[],d:number[])=>orientation(a,b,c)!==orientation(a,b,d)&&orientation(c,d,a)!==orientation(c,d,b);
  const spatialRelation=(geometry:any,draw:number[][]):'intersection'|'containment'|'contact'|null=>{const rings=polygonRings(geometry);const points=rings.flat();const allInside=points.length>0&&points.every((point)=>inside(point,draw));if(allInside)return'containment';const unitInsideDraw=points.some((point)=>inside(point,draw));const drawInsideUnit=draw.some((point)=>rings.some((ring)=>inside(point,ring)));let boundary=false;for(const ring of rings)for(let i=1;i<ring.length;i++)for(let j=1;j<draw.length;j++)if(crosses(ring[i-1],ring[i],draw[j-1],draw[j]))boundary=true;if(unitInsideDraw||drawInsideUnit||boundary)return'intersection';const rounded=new Set(draw.map((point)=>`${point[0].toFixed(5)},${point[1].toFixed(5)}`));return points.some((point)=>rounded.has(`${point[0].toFixed(5)},${point[1].toFixed(5)}`))?'contact':null;};
  const announce = (text: string) => { const node = $('[data-operation-status]'); if (node) node.textContent = text; };
  const download = (name: string, type: string, content: string) => {
    const url = URL.createObjectURL(new Blob([content], { type }));
    const anchor = document.createElement('a'); anchor.href = url; anchor.download = name; anchor.click();
    setTimeout(() => URL.revokeObjectURL(url), 0);
  };
  const editable = () => {
    if (!timeline) { announce('Cree o seleccione un escenario editable.'); return false; }
    return true;
  };
  const enableScenarioActions = (enabled: boolean) => {
    $$<HTMLButtonElement>('[data-duplicate-scenario],[data-rename-scenario],[data-archive-scenario],[data-delete-scenario],[data-export-json],[data-export-geojson],[data-export-csv],[data-export-method],[data-share-link],[data-compare-current]').forEach((button) => button.disabled = !enabled);
  };
  const selectedUnits = () => [...selected.values()];
  const renderSelection = () => {
    const summary = $('[data-selection-summary]');
    if (summary) summary.textContent = selected.size ? selectedUnits().map((item) => `${item.name} (${item.code})`).join(', ') : 'Ninguna';
    $$<HTMLInputElement>('[data-territory-check]').forEach((input) => input.checked = selected.has(input.value));
    const departmentFeatures = selectedUnits().filter((item)=>item.level==='department' && item.geometry).map((item)=>({type:'Feature',id:item.id,properties:{code:item.code,name:item.name},geometry:item.geometry}));
    const municipalityFeatures = selectedUnits().filter((item)=>item.level==='municipality' && item.geometry).map((item)=>({type:'Feature',id:item.id,properties:{code:item.code,name:item.name},geometry:item.geometry}));
    document.dispatchEvent(new CustomEvent('territorial:selection-geometry',{detail:{departments:{type:'FeatureCollection',features:departmentFeatures},municipalities:{type:'FeatureCollection',features:municipalityFeatures}}}));
    const universe = $('[data-selection-universe]'); if (universe) universe.textContent = municipalities.length ? `Universo visible: 33 departamentos y ${municipalities.length} municipios del departamento cargado. Invertir opera sobre este universo visible.` : 'Universo visible: 33 departamentos y Distrito Capital.';
  };
  const select = (unit: Selection, additive = false) => {
    if (!additive) selected.clear();
    selected.set(unit.id, unit);
    renderSelection();
    announce(`${unit.name} seleccionada.`);
    const card = $('[data-territory-card]');
    if (card) {
      card.textContent = '';
      appendText(card, 'h3', unit.name);
      const dl = document.createElement('dl');
      const entries = [
        ['Código', unit.code],
        ['Naturaleza', unit.level === 'department' ? (unit.code === '11' ? 'Distrito Capital / entidad territorial' : 'Departamento / entidad territorial') : (unit.unitType ?? 'Tipo territorial no suministrado por la fuente')],
        ['Unidad superior', unit.level === 'department' ? 'Nación' : `Departamento ${unit.code.slice(0, 2)}`],
        ['Autoridades y competencias', 'Régimen vigente; detalle territorial no conectado.'],
        ['Ingresos, transferencias e indicadores', 'Fuente pendiente; no disponible.'],
        ['Fuente, fecha y calidad', 'DANE DIVIPOLA MGN 2025 · geometría observada · cobertura cartográfica nacional.'],
      ];
      for (const [term, description] of entries) {
        const div = document.createElement('div'); appendText(div, 'dt', term); appendText(div, 'dd', description); dl.append(div);
      }
      card.append(dl);
    }
  };
  const renderTable = () => {
    const table = $('[data-territory-table]');
    if (!table) return;
    const query = ($<HTMLInputElement>('[data-table-filter]')?.value ?? '').toLocaleLowerCase('es');
    const items = [...departments.map((feature) => ({ feature, level: 'department' as const })), ...municipalities.map((feature) => ({ feature, level: 'municipality' as const }))]
      .filter(({ feature }) => `${feature.properties.code} ${feature.properties.name}`.toLocaleLowerCase('es').includes(query));
    table.textContent = '';
    for (const { feature, level } of items) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      const input = document.createElement('input'); input.type = 'checkbox'; input.value = `${level}:${feature.properties.code}`; input.dataset.territoryCheck = '';
      input.setAttribute('aria-label', `Seleccionar ${feature.properties.name}`);
      input.addEventListener('change', () => {
        const unit = { id: input.value, code: feature.properties.code, name: feature.properties.name, level, unitType: feature.properties.MPIO_TIPO, geometry: feature.geometry };
        if (input.checked) selected.set(input.value, unit); else selected.delete(input.value);
        renderSelection();
      });
      cell.append(input); row.append(cell);
      for (const value of [feature.properties.code, feature.properties.name, level === 'department' ? 'Departamento' : 'Unidad territorial', level === 'department' ? 'DEPARTAMENTO' : (feature.properties.MPIO_TIPO ?? 'Sin dato disponible'), 'DANE DIVIPOLA MGN 2025']) {
        const td = document.createElement('td'); td.textContent = value; row.append(td);
      }
      table.append(row);
    }
    renderSelection();
  };
  const ingestDepartments = (features: Array<any>) => {
    departments = features;
    const selectNode = $<HTMLSelectElement>('[data-department-select]');
    if (selectNode) {
      const previous = selectNode.value;
      selectNode.textContent = '';
      selectNode.add(new Option('Colombia', ''));
      departments.forEach((feature) => selectNode.add(new Option(feature.properties.name, feature.properties.code)));
      if ([...selectNode.options].some((option) => option.value === previous)) selectNode.value = previous;
    }
    renderTable();
  };
  const loadTableFallback = async () => {
    try {
      const response = await fetch('/data/territorial/geography/departments.geojson', { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const collection = await response.json();
      if (collection?.type !== 'FeatureCollection' || !Array.isArray(collection.features) || !collection.features.length) throw new Error('GeoJSON sin entidades');
      ingestDepartments(collection.features);
    } catch (error) {
      const table = $('[data-territory-table]');
      if (table) table.textContent = `No fue posible cargar la tabla: ${error instanceof Error ? error.message : String(error)}`;
    }
  };
  const renderScenario = async () => {
    const scenario = timeline?.current;
    enableScenarioActions(Boolean(scenario));
    const history = $('[data-scenario-history]');
    const summary = $('[data-scenario-summary]');
    const legal = $('[data-legal-impact]');
    if (!scenario) {
      if (history) { history.textContent = ''; appendText(history, 'li', 'Sin operaciones en el escenario actual.'); }
      if (summary) summary.textContent = 'Estado actual bloqueado; no contiene operaciones editables.';
      return;
    }
    const classified = classifyLegalImpact(scenario);
    if (history) {
      history.textContent = '';
      if (!scenario.history.length) appendText(history, 'li', 'Escenario creado; sin operaciones adicionales.');
      for (const item of scenario.history) { const li = document.createElement('li'); li.textContent = `${item.at} · ${item.summary}`; history.append(li); }
    }
    if (summary) summary.textContent = `${scenario.name} · ${scenario.history.length} operaciones · base ${scenario.baseScenarioId} · guardado local`;
    if (legal) {
      legal.textContent = '';
      for (const impact of classified.legalImpacts) { const article = document.createElement('article'); const strong = document.createElement('strong'); strong.textContent = impact.category; const p = document.createElement('p'); p.textContent = `${impact.trigger}: ${impact.rationale} Fuente: ${impact.source}.`; article.append(strong, p); legal.append(article); }
    }
    const consequences = $('[data-consequence-output]');
    if (consequences) renderConsequenceItems(consequences, scenario.consequences, 'Escenario base materializado; aplique una operación para recalcular consecuencias.');
    const operationResult = $('[data-operation-result]');
    if (operationResult) {
      operationResult.textContent = '';
      appendText(operationResult, 'p', scenario.history.length
        ? `Operación aplicada: ${scenario.history.at(-1)!.summary}. Unidades afectadas: ${selected.size || 'según historial'}. Resultado: escenario actualizado. Advertencias: revise datos faltantes e incertidumbre. Puede deshacer.`
        : 'Sin operaciones. Deshacer estará disponible después de aplicar una.');
    }
    const competenceLevel = $<HTMLSelectElement>('[data-competence-level]');
    if (competenceLevel) { const value=competenceLevel.value; competenceLevel.textContent=''; for(const level of scenario.levels) competenceLevel.add(new Option(`${level.name} · nivel`,level.id)); for(const unit of scenario.units.filter((item)=>item.state==='active').slice(0,100)) competenceLevel.add(new Option(`${unit.name} · unidad`,unit.id)); if([...competenceLevel.options].some((option)=>option.value===value)) competenceLevel.value=value; }
    const tree = $('[data-hierarchy-tree]'); if (tree) { tree.textContent = ''; const ul = document.createElement('ul'); for (const level of scenario.levels) appendText(ul, 'li', `${level.order}. ${level.name} · ${level.nature}`); tree.append(ul); }
    const mapCollections = scenarioToMapCollections(scenario);
    document.dispatchEvent(new CustomEvent('territorial:scenario-collections', { detail: mapCollections }));
    document.dispatchEvent(new CustomEvent('territorial:scenario-geometry', { detail: mapCollections['scenario-units'] }));
    $('[data-save-status]')!.textContent = 'Guardando…';
    try {
      await store.save(scenario);
      scenarios.set(scenario.id, scenario);
      $('[data-save-status]')!.textContent = 'Guardado local';
      refreshScenarioLists(scenario.id);
    } catch (error) {
      $('[data-save-status]')!.textContent = 'Error de guardado';
      announce(`IndexedDB: ${error instanceof Error ? error.message : String(error)}`);
    }
  };
  const apply = (next: TerritorialScenario) => { timeline?.apply(next); void renderScenario(); updateUndoRedo(); };
  const updateUndoRedo = () => {
    const undo = $<HTMLButtonElement>('[data-undo]'); const redo = $<HTMLButtonElement>('[data-redo]');
    if (undo) undo.disabled = !timeline; if (redo) redo.disabled = !timeline;
  };
  const refreshScenarioLists = (active?: string) => {
    for (const selector of ['[data-local-scenarios]', '[data-compare-a]', '[data-compare-b]']) {
      const selectNode = $<HTMLSelectElement>(selector); if (!selectNode) continue;
      const previous = active ?? selectNode.value; selectNode.textContent = '';
      if (selector === '[data-local-scenarios]') { const option = new Option('Estado actual · bloqueado', 'current'); selectNode.add(option); }
      for (const scenario of scenarios.values()) selectNode.add(new Option(`${scenario.name}${scenario.status === 'archived' ? ' · archivado' : ''}`, scenario.id));
      if ([...selectNode.options].some((option) => option.value === previous)) selectNode.value = previous;
    }
  };
  const setMobilePanel = (next: MobilePanel) => {
    $$<HTMLElement>('[data-panel]').forEach((panel) => panel.dataset.mobileActive = String(panel.dataset.panel === next));
    $$<HTMLButtonElement>('[data-mobile-tab]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mobileTab === next)));
    window.dispatchEvent(new CustomEvent('territorial:resize'));
  };
  const defaultPanel: Record<LabMode, MobilePanel> = { raices: 'map', savia: 'results', semillas: 'controls' };
  const setMode = (next: LabMode, chooseDefaultPanel = true) => {
    mode = next;
    $$<HTMLElement>('[data-workspace]').forEach((workspace) => workspace.hidden = workspace.dataset.workspace !== mode);
    $$<HTMLButtonElement>('[data-mode]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mode === mode)));
    document.body.dataset.labMode = mode;
    const descriptions = {
      raices: 'RAÍCES muestra el sistema actual y no habilita operaciones de edición.',
      savia: 'SAVIA evalúa la selección sin modificar el escenario oficial.',
      semillas: 'SEMILLAS permite editar únicamente escenarios locales exploratorios.',
    };
    const result = $('[data-mode-result]'); if (result) result.textContent = descriptions[mode];
    const legend = $('[data-map-legend]'); if (legend) legend.textContent = `${mode === 'raices' ? 'RAÍCES · consulta oficial' : mode === 'savia' ? 'SAVIA · perfil multidimensional' : 'SEMILLAS · hipótesis editable'}`;
    const params = new URLSearchParams(location.search); params.set('mode', mode); history.replaceState(null, '', `${location.pathname}?${params}`);
    if (chooseDefaultPanel) setMobilePanel(defaultPanel[mode]);
    else window.dispatchEvent(new CustomEvent('territorial:resize'));
  };
  $$<HTMLButtonElement>('[data-mode]').forEach((button) => button.addEventListener('click', () => setMode(button.dataset.mode as LabMode)));
  $$<HTMLButtonElement>('[data-mobile-panel]').forEach((button) => button.addEventListener('click', () => {
    setMobilePanel(button.dataset.mobilePanel as MobilePanel);
  }));
  $('[data-view-table]')?.addEventListener('click', () => {
    document.querySelector('#selected-table-title')?.scrollIntoView({ block: 'start' });
  });
  document.addEventListener('territorial:departments', ((event: CustomEvent<any>) => {
    ingestDepartments(event.detail.features);
    void fetch('/data/territorial/geography/municipalities-index.json').then((response) => response.json()).then((items) => {
      municipalityIndex = items;
      const list = $('[data-search-results]');
      if (list) {
        list.textContent = '';
        for (const value of [...departments.map((feature: any) => `${feature.properties.code} · ${feature.properties.name}`), ...items.map((item: any) => `${item.code} · ${item.name} · ${item.departmentCode}`)]) {
          const option = document.createElement('option'); option.value = value; list.append(option);
        }
      }
    });
  }) as EventListener);
  document.addEventListener('territorial:municipalities', ((event: CustomEvent<any>) => {
    municipalities = event.detail.features;
    const selectNode = $<HTMLSelectElement>('[data-municipality-select]');
    if (selectNode) { selectNode.disabled = false; selectNode.textContent = ''; selectNode.add(new Option('Todos los municipios', '')); municipalities.forEach((feature) => selectNode.add(new Option(feature.properties.name, feature.properties.code))); }
    renderTable();
  }) as EventListener);
