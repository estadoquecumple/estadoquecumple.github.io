  $('[data-undo]')?.addEventListener('click', () => { timeline?.undo(); void renderScenario(); });
  $('[data-redo]')?.addEventListener('click', () => { timeline?.redo(); void renderScenario(); });
  $('[data-export-json]')?.addEventListener('click', async () => {
    if (!timeline) return;
    foundation ??= await fetch('/data/territorial/current/foundation-v4.json').then((response) => {
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return response.json();
    });
    const capsule = createCapsule(timeline.current, {
      commit: foundation.commit,
      contractVersion: '4.0.0',
      legalRegistryVersion: '3.0.0',
      datasets: [foundation.catalog, ...foundation.analytics].map((item:any) => ({ id:item.path, version:'4.0.0', sha256:item.sha256 })),
      rules: foundation.rules,
      models: [],
    }, { compilation: compileScenario(timeline.current) });
    download(`${timeline.current.id}.json`, 'application/json', JSON.stringify({ schemaVersion:4, scenario:timeline.current, capsule }, null, 2));
  });
  $('[data-export-geojson]')?.addEventListener('click', () => timeline && download(`${timeline.current.id}.geojson`, 'application/geo+json', JSON.stringify({ type: 'FeatureCollection', features: timeline.current.units.filter((unit) => unit.geometry).map((unit) => ({ type: 'Feature', id: unit.id, properties: { name: unit.name, state: unit.state, resultKind: 'assumption' }, geometry: unit.geometry })) }, null, 2)));
  $('[data-export-csv]')?.addEventListener('click', () => timeline && download(`${timeline.current.id}.csv`, 'text/csv', scenarioCsv(timeline.current.units.map((unit)=>({id:unit.id,nombre:unit.name,estado:unit.state,tipo:'assumption'})),['id','nombre','estado','tipo'])));
  $('[data-export-method]')?.addEventListener('click', () => timeline && download(`${timeline.current.id}-metodologia.txt`, 'text/plain', `${timeline.current.name}\nBase: ${timeline.current.baseScenarioId}\nOperaciones: ${timeline.current.history.length}\nTodo resultado se clasifica como observed, calculated, assumption o unavailable.\nNo constituye concepto jurídico.`));
  $('[data-share-link]')?.addEventListener('click', async () => { if (!timeline) return; const bytes = new TextEncoder().encode(exportScenario(timeline.current)); const compact = btoa(Array.from(bytes, (byte) => String.fromCharCode(byte)).join('')); if (compact.length > 1800) { download(`${timeline.current.id}.json`,'application/json',exportScenario(timeline.current)); return announce('El escenario completo excede el límite seguro del enlace: se generó un archivo V3 exportable.'); } const url = `${location.origin}${location.pathname}?mode=semillas&share=${encodeURIComponent(compact)}`; await navigator.clipboard?.writeText(url); announce('Enlace V3 completo copiado. Incluye unidades, fuentes, supuestos, operaciones y configuración.'); });
  $('[data-print]')?.addEventListener('click', () => window.print());
  $<HTMLInputElement>('[data-import-json]')?.addEventListener('change', async (event) => {
    const file = (event.currentTarget as HTMLInputElement).files?.[0]; if (!file) return;
    try { const parsed=JSON.parse(await file.text()); const scenario = importScenario(parsed.scenario ?? parsed); scenarios.set(scenario.id, scenario); timeline = new ScenarioTimeline(scenario); await renderScenario(); announce('Escenario importado y validado.'); } catch (error) { announce(error instanceof Error ? error.message : String(error)); }
  });
  const comparison = (a: TerritorialScenario | undefined, b: TerritorialScenario | undefined) => {
    const output = $('[data-comparison-output]'); if (!output || !a) return;
    const baseline = b ?? createScenario('Estado actual');
    output.textContent = '';
    const table=document.createElement('table');const head=document.createElement('thead');const header=document.createElement('tr');
    for(const value of ['Cambio',baseline.name,a.name])appendText(header,'th',value);head.append(header);
    const body=document.createElement('tbody');
    const rows=[
      ['Unidades',baseline.units.length,a.units.length],
      ['Competencias',baseline.competences.length,a.competences.length],
      ['Gobiernos',baseline.governments.length,a.governments.length],
      ['Reglas fiscales',baseline.finances.length,a.finances.length],
      ['Impacto jurídico','Referencia vigente',classifyLegalImpact(a).legalImpacts.map((item)=>item.category).join('; ')],
      ['Cobertura','observed',a.assumptions.length?'assumption / unavailable':'calculated'],
    ];
    for(const values of rows){const row=document.createElement('tr');appendText(row,'th',String(values[0]));appendText(row,'td',String(values[1]));appendText(row,'td',String(values[2]));body.append(row);}
    table.append(head,body);output.append(table);
  };
  $('[data-compare-current]')?.addEventListener('click', () => comparison(timeline?.current, undefined));
  $('[data-compare-scenarios]')?.addEventListener('click', () => comparison(scenarios.get($<HTMLSelectElement>('[data-compare-a]')!.value), scenarios.get($<HTMLSelectElement>('[data-compare-b]')!.value)));
  try {
    const migration = migrateLocalState(localStorage);
    if (migration.discardedScenarios && !sessionStorage.getItem('cams-v2-migration-notice')) {
      $('[data-migration-notice]')?.removeAttribute('hidden'); sessionStorage.setItem('cams-v2-migration-notice', 'shown');
    }
  } catch { announce('No fue posible revisar preferencias locales antiguas.'); }
  store.list().then((items) => { items.forEach((scenario) => scenarios.set(scenario.id, scenario)); refreshScenarioLists(); }).catch((error) => announce(`IndexedDB no disponible: ${error.message}`));
  $<HTMLSelectElement>('[data-experience-mode]')?.addEventListener('change', (event) => {
    const value=(event.currentTarget as HTMLSelectElement).value;
    document.body.dataset.experienceLevel=value;
    $$<HTMLElement>('[data-expert-only]').forEach((element)=>{element.hidden=value!=='expert';});
    $$<HTMLElement>('[data-guided-only]').forEach((element)=>{element.hidden=value==='expert';});
    $$<HTMLElement>('[data-phase3a-expert]').forEach((element)=>{element.hidden=value!=='expert';});
    $$<HTMLElement>('[data-phase3a-guided]').forEach((element)=>{element.hidden=value==='expert';});
    announce(value==='expert'?'Modo experto: se muestran trazabilidad y restricciones completas.':'Modo guiado: se priorizan pasos y explicaciones.');
  });
  $<HTMLInputElement>('[data-layer-h3]')?.addEventListener('change', async (event) => {
    const enabled=(event.currentTarget as HTMLInputElement).checked;
    const status=$('[data-h3-status]');
    if(!enabled){document.dispatchEvent(new CustomEvent('territorial:h3',{detail:{enabled:false,records:[]}}));if(status)status.textContent='Malla H3 oculta; no reemplaza límites administrativos o legales.';return;}
    try{
      const documentV4=await fetch('/data/territorial/analytics/h3-divipola.json').then((response)=>{if(!response.ok)throw new Error(`HTTP ${response.status}`);return response.json();});
      document.dispatchEvent(new CustomEvent('territorial:h3',{detail:{enabled:true,records:documentV4.records}}));
      if(status)status.textContent=`${documentV4.records.length} asociaciones DIVIPOLA–H3 · resolución ${documentV4.resolution}. ${documentV4.warning}`;
    }catch(error){(event.currentTarget as HTMLInputElement).checked=false;if(status)status.textContent=`H3 no disponible: ${error instanceof Error?error.message:String(error)}`;}
  });
  $('[data-v4-catalog]')?.addEventListener('toggle', async (event) => {
    if (!(event.currentTarget as HTMLDetailsElement).open || catalogLoaded) return;
    const summary=$('[data-catalog-summary]'); const body=$('[data-source-catalog]');
    try {
      const catalog=await fetch('/data/territorial/catalog/sources.json').then((response)=>{if(!response.ok)throw new Error(`HTTP ${response.status}`);return response.json();});
      foundation=await fetch('/data/territorial/current/foundation-v4.json').then((response)=>{if(!response.ok)throw new Error(`HTTP ${response.status}`);return response.json();});
      if(summary)summary.textContent=`${catalog.sources.length} fuentes · catálogo ${catalog.version} · ${catalog.policy.pricing}.`;
      if(body){body.textContent='';for(const source of catalog.sources){const row=document.createElement('tr');appendText(row,'td',source.entity);appendText(row,'td',source.snapshot??'Sin snapshot publicado');appendText(row,'td',source.hash??'Sin hash de original');appendText(row,'td',source.data_date??source.downloaded_at??'Fecha no publicada');appendText(row,'td',source.coverage);appendText(row,'td',(source.transformations??[]).join('; '));appendText(row,'td',(source.limitations??[]).join('; '));appendText(row,'td',source.quality_status);const cell=document.createElement('td');const link=document.createElement('a');link.href=source.url;link.target='_blank';link.rel='noreferrer';link.textContent=`Abrir ${source.id}`;cell.append(link);row.append(cell);body.append(row);}}
      const analytics=new TerritorialAnalytics();
      const result=await analytics.query({sql:'SELECT count(*) AS records FROM territorial.parquet',parquetUrl:'/data/territorial/analytics/catalog.parquet',fallbackUrl:'/data/territorial/catalog/sources.json',maxBytes:10_000_000});
      analytics.cancelAll();
      catalogLoaded=true;
      const status=$('[data-analytics-status]');if(status)status.textContent=result.ok?`Motor ${result.engine}: catálogo analítico disponible.${result.engine==='json-fallback'&&result.error?` DuckDB no pudo consultar: ${result.error}`:''}`:`Motor analítico no disponible: ${result.error}`;
    } catch(error) { if(summary)summary.textContent=`Catálogo no disponible: ${error instanceof Error?error.message:String(error)}`; }
  });
  const loadRecords=(url:string,assign:(records:any[])=>void,label:string)=>fetch(url).then((response)=>{if(!response.ok)throw new Error(`HTTP ${response.status}`);return response.json();}).then((document)=>assign(document.records??[])).catch((error)=>announce(`${label} no disponible; los demás datos siguen operativos: ${error instanceof Error?error.message:String(error)}`));
  void loadRecords('/data/territorial/government/entities-by-territory.json',(records)=>{governmentMetrics=records;},'Entidades públicas');
  void loadRecords('/data/territorial/indicators/sgr-aggregates.json',(records)=>{sgrMetrics=records;},'SGR');
  void loadRecords('/data/territorial/indicators/secop-aggregates.json',(records)=>{secopMetrics=records;},'SECOP II');
  void fetch('/data/territorial/official-sources.json').then((response)=>{if(!response.ok)throw new Error(`HTTP ${response.status}`);return response.json();}).then((registry)=>{
    const host=$('[data-official-sources]');if(host){host.textContent='';for(const source of registry.sources??[]){const li=document.createElement('li');const link=document.createElement('a');link.textContent=`${source.topic} — ${source.authority}`;link.href=source.url;link.target='_blank';link.rel='noopener noreferrer';li.append(link,` · ${source.integration} · ${source.coverage}`);host.append(li);}}
  }).catch((error)=>{const host=$('[data-official-sources]');if(host)host.textContent=`Registro de fuentes no disponible; los indicadores cargados conservan su estado: ${error instanceof Error?error.message:String(error)}`;});
  const initialParams = new URLSearchParams(location.search);
  const shared = initialParams.get('share');
  if (shared) try {
    const binary = atob(shared);
    const bytes = Uint8Array.from(binary, (character) => character.charCodeAt(0));
    const scenario = importScenario(JSON.parse(new TextDecoder().decode(bytes)));
    scenarios.set(scenario.id, scenario);
    timeline = new ScenarioTimeline(scenario);
    void renderScenario();
    announce(`Escenario compartido V${scenario.schemaVersion} importado y validado; no se ejecutó contenido.`);
  } catch (error) {
    announce(`Enlace compartido rechazado: ${error instanceof Error ? error.message : String(error)}`);
  }
  const requestedMode = initialParams.get('mode');
  const aliases: Record<string, LabMode> = { roots: 'raices', sap: 'savia', seeds: 'semillas' };
  const canonicalModes: LabMode[] = ['raices', 'savia', 'semillas'];
  const initialMode = requestedMode && aliases[requestedMode]
    ? aliases[requestedMode]
    : canonicalModes.includes(requestedMode as LabMode) ? requestedMode as LabMode : 'raices';
  setMode(initialMode);
  document.body.dataset.experienceLevel='guided';
  void loadTableFallback();
</script>
