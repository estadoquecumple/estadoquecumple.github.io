---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TerritorialLab from '../../../components/territorial/TerritorialLab.astro';
import { LAB_RELEASE_VISIBLE } from '../../../config/release';
const title='Laboratorio Territorial CAMS';
const description='Consulte el Estado territorial vigente, evalúe capacidades y modele alternativas institucionales con trazabilidad, persistencia y comparación.';
---
<BaseLayout {title} {description} currentPath="/observatorio/laboratorio-territorial/">
  <header class="lab-hero"><div class="container"><p class="eyebrow">Observatorio · Modelador territorial público</p><h1>{title}</h1><p>{description}</p><p><strong>Advertencia:</strong> los escenarios son exploratorios, no alteran límites oficiales y la clasificación jurídica preliminar no constituye concepto legal.</p><dl><div><dt>Versión</dt><dd>{LAB_RELEASE_VISIBLE}</dd></div><div><dt>Llave territorial</dt><dd>DIVIPOLA</dd></div><div><dt>Persistencia</dt><dd>Local · IndexedDB</dd></div><div><dt>Cobertura cartográfica</dt><dd>Nacional</dd></div></dl></div></header>
  <div class="container lab-page"><TerritorialLab/></div>
</BaseLayout>
