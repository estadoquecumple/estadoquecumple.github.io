---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/global/PageHero.astro';
---
<BaseLayout title="Observatorio de capacidad pública" description="Observatorio de capacidad pública y acceso al Laboratorio Territorial CAMS." currentPath="/observatorio/">
  <PageHero eyebrow="Conocimiento · Datos y método" title="Observatorio de capacidad pública" lead="Infraestructura metodológica para seguir capacidad institucional sin confundir evidencia, cálculos e hipótesis." status="Modelador territorial disponible"/>
  <div class="container page">
    <section class="section callout"><h2>Laboratorio Territorial CAMS · modelador de escenarios</h2><p>RAÍCES consulta el sistema vigente, SAVIA evalúa capacidades y SEMILLAS construye alternativas territoriales e institucionales trazables.</p><a class="button primary" href="/observatorio/laboratorio-territorial/?mode=raices">Abrir Laboratorio Territorial</a></section>
    <section class="section"><h2>Método de publicación</h2><ol class="process"><li>Pregunta y unidad</li><li>Fuente y corte</li><li>Diccionario</li><li>Calidad y sesgos</li><li>Versión y límites</li></ol><div class="cards"><article class="card"><h3>Fuentes</h3><p>Origen, cobertura, fecha, licencia y restricciones.</p></article><article class="card"><h3>Indicador</h3><p>Definición, fórmula, unidad y tratamiento de ausencias.</p></article><article class="card"><h3>Datos</h3><p>Archivo descargable y reproducible tras validación.</p></article><article class="card"><h3>Visualización</h3><p>Mapa accesible con tabla alternativa y notas.</p></article></div></section>
  </div>
</BaseLayout>
